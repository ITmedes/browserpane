    {
      "datasource": { "type": "prometheus", "uid": "browserpane-prometheus" },
      "description": "Event-delivery retries observed during the rolling fifteen-minute window. A retry is degraded delivery, not necessarily terminal failure.",
      "fieldConfig": { "defaults": { "decimals": 0, "min": 0, "noValue": "No data", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }] }, "unit": "short" }, "overrides": [] },
