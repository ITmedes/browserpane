      "targets": [{ "datasource": { "type": "prometheus", "uid": "browserpane-prometheus" }, "editorMode": "code", "expr": "browserpane:recording_artifact_finalize_failures:increase15m", "instant": true, "legendFormat": "Finalization failures", "range": false, "refId": "A" }],
