      "targets": [{ "datasource": { "type": "prometheus", "uid": "browserpane-prometheus" }, "editorMode": "code", "expr": "browserpane:recording_failures:increase15m", "instant": true, "legendFormat": "Recording failures", "range": false, "refId": "A" }],
