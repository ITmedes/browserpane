      "id": 13,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showPercentChange": false, "textMode": "auto", "wideLayout": true },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "browserpane-prometheus" }, "editorMode": "code", "expr": "browserpane:workflow_event_delivery_retries:increase15m", "instant": true, "legendFormat": "Delivery retries", "range": false, "refId": "A" }],
      "title": "Event delivery retries",
