{
  "annotations": {
    "list": []
  },
  "description": "Aggregate BrowserPane starter indicators. No panel exposes owner, project, session, workflow, recording, URL, credential, payload, browser-content, raw-error, or artifact-reference dimensions. Thresholds are operating proposals and require deployment-specific calibration.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [],
      "targetBlank": true,
      "title": "BrowserPane alert runbook",
      "tooltip": "Open aggregate alert triage and recovery guidance",
      "type": "link",
      "url": "https://github.com/ITmedes/browserpane/blob/main/docs/operations/PROMETHEUS_ALERT_RUNBOOK.md"
    }
  ],
  "panels": [
    {
      "datasource": null,
      "description": "This dashboard shows aggregate starter indicators only. Undefined ratios mean no qualifying activity, not guaranteed success. Runtime utilization measures assignment slots rather than CPU, memory, queue depth, or tested concurrency.",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "content": "## BrowserPane operations baseline\nUse this view to select the relevant runbook path. Calibrate thresholds against a named deployment and workload before paging or external reporting.",
        "mode": "markdown"
      },
      "title": "Scope and interpretation",
      "transparent": true,
      "type": "text"
    },
    {
      "datasource": { "type": "prometheus", "uid": "browserpane-prometheus" },
      "description": "Maximum aggregate scrape health for the configured BrowserPane gateway job. Unavailable means Prometheus cannot currently scrape a gateway target.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "text": "Unavailable" }, "1": { "color": "green", "text": "Available" } }, "type": "value" },
            { "options": { "match": "null", "result": { "color": "red", "text": "No data" } }, "type": "special" }
          ],
          "noValue": "No data",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 4 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showPercentChange": false, "textMode": "auto", "wideLayout": true },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "browserpane-prometheus" }, "editorMode": "code", "expr": "max(up{job=\"browserpane-gateway\"})", "instant": true, "legendFormat": "Gateway scrape", "range": false, "refId": "A" }],
      "title": "Gateway scrape health",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "browserpane-prometheus" },
      "description": "Aggregate gateway request throughput over five minutes. Traffic volume is context for interpreting ratios; it is not a capacity envelope.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 12, "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": false }, "noValue": "No traffic", "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 4 },
      "id": 3,
      "options": { "legend": { "calcs": ["lastNotNull", "mean"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "browserpane-prometheus" }, "editorMode": "code", "expr": "browserpane:gateway_http_requests:rate5m", "legendFormat": "Requests", "range": true, "refId": "A" }],
      "title": "Gateway request rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "browserpane-prometheus" },
      "description": "Aggregate gateway 5xx ratio over five minutes. Undefined means no requests in the window. The five-percent threshold mirrors the starter alert proposal.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "custom": { "drawStyle": "line", "fillOpacity": 12, "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": false }, "max": 1, "min": 0, "noValue": "No traffic", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.05 }] }, "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 4 },
      "id": 4,
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "browserpane-prometheus" }, "editorMode": "code", "expr": "browserpane:gateway_http_5xx:ratio_rate5m", "legendFormat": "5xx ratio", "range": true, "refId": "A" }],
      "title": "Gateway server-error ratio",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "browserpane-prometheus" },
      "description": "Aggregate p95 gateway response duration from the five-minute histogram window. This includes all bounded route templates and is not an end-to-end workflow latency SLO.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "custom": { "drawStyle": "line", "fillOpacity": 12, "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": false }, "min": 0, "noValue": "No traffic", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 3 }] }, "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 4 },
      "id": 5,
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "browserpane-prometheus" }, "editorMode": "code", "expr": "browserpane:gateway_http_request_duration_seconds:p95_rate5m", "legendFormat": "p95 duration", "range": true, "refId": "A" }],
      "title": "Gateway p95 duration",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "browserpane-prometheus" },
      "description": "Active plus starting assignments divided by the configured assignment limit. This is slot utilization, not host CPU or memory utilization.",
      "fieldConfig": { "defaults": { "max": 1, "min": 0, "noValue": "No data", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.8 }, { "color": "red", "value": 1 }] }, "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 10 },
      "id": 6,
      "options": { "minVizHeight": 75, "minVizWidth": 75, "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showThresholdLabels": false, "showThresholdMarkers": true, "sizing": "auto" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "browserpane-prometheus" }, "editorMode": "code", "expr": "browserpane:runtime_capacity_utilization:ratio", "instant": true, "legendFormat": "Assignment utilization", "range": false, "refId": "A" }],
      "title": "Runtime slot utilization",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "browserpane-prometheus" },
      "description": "Current aggregate count of active runtime assignments across the configured runtime backend.",
      "fieldConfig": { "defaults": { "color": { "fixedColor": "blue", "mode": "fixed" }, "decimals": 0, "min": 0, "noValue": "No data", "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 10 },
      "id": 7,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showPercentChange": false, "textMode": "auto", "wideLayout": true },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "browserpane-prometheus" }, "editorMode": "code", "expr": "browserpane_gateway_runtime_active_assignments", "instant": true, "legendFormat": "Active", "range": false, "refId": "A" }],
      "title": "Active runtime assignments",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "browserpane-prometheus" },
      "description": "Current aggregate count of runtime assignments that are starting but not yet active.",
      "fieldConfig": { "defaults": { "color": { "fixedColor": "orange", "mode": "fixed" }, "decimals": 0, "min": 0, "noValue": "No data", "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 10 },
      "id": 8,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showPercentChange": false, "textMode": "auto", "wideLayout": true },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "browserpane-prometheus" }, "editorMode": "code", "expr": "browserpane_gateway_runtime_starting_assignments", "instant": true, "legendFormat": "Starting", "range": false, "refId": "A" }],
      "title": "Starting runtime assignments",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "browserpane-prometheus" },
      "description": "Configured aggregate assignment limit. It is an admission limit rather than a measured performance or concurrency envelope.",
      "fieldConfig": { "defaults": { "color": { "fixedColor": "semi-dark-blue", "mode": "fixed" }, "decimals": 0, "min": 0, "noValue": "No data", "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 10 },
      "id": 9,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showPercentChange": false, "textMode": "auto", "wideLayout": true },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "browserpane-prometheus" }, "editorMode": "code", "expr": "browserpane_gateway_runtime_assignment_limit", "instant": true, "legendFormat": "Limit", "range": false, "refId": "A" }],
      "title": "Runtime assignment limit",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "browserpane-prometheus" },
      "description": "Produced-file upload failure ratio over fifteen minutes. Undefined means no upload activity, not guaranteed success.",
      "fieldConfig": { "defaults": { "mappings": [{ "options": { "match": "null", "result": { "color": "dark-gray", "text": "No activity" } }, "type": "special" }], "max": 1, "min": 0, "noValue": "No activity", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.01 }] }, "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 16 },
      "id": 10,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showPercentChange": false, "textMode": "auto", "wideLayout": true },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "browserpane-prometheus" }, "editorMode": "code", "expr": "browserpane:workflow_produced_file_upload_failure:ratio_increase15m", "instant": true, "legendFormat": "Upload failure ratio", "range": false, "refId": "A" }],
      "title": "Produced-file failure ratio",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "browserpane-prometheus" },
      "description": "Count of produced-file upload failures observed during the rolling fifteen-minute window.",
      "fieldConfig": { "defaults": { "decimals": 0, "min": 0, "noValue": "No data", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 16 },
      "id": 11,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showPercentChange": false, "textMode": "auto", "wideLayout": true },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "browserpane-prometheus" }, "editorMode": "code", "expr": "browserpane:workflow_produced_file_upload_failures:increase15m", "instant": true, "legendFormat": "Upload failures", "range": false, "refId": "A" }],
      "title": "Produced-file failures",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "browserpane-prometheus" },
      "description": "Successful event deliveries divided by delivery attempts over fifteen minutes. Undefined means no delivery activity.",
      "fieldConfig": { "defaults": { "mappings": [{ "options": { "match": "null", "result": { "color": "dark-gray", "text": "No activity" } }, "type": "special" }], "max": 1, "min": 0, "noValue": "No activity", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 0.95 }, { "color": "green", "value": 0.99 }] }, "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 16 },
      "id": 12,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showPercentChange": false, "textMode": "auto", "wideLayout": true },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "browserpane-prometheus" }, "editorMode": "code", "expr": "browserpane:workflow_event_delivery_success:ratio_increase15m", "instant": true, "legendFormat": "Delivery success", "range": false, "refId": "A" }],
      "title": "Event delivery success",
      "type": "stat"
