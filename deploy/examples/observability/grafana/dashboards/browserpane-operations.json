      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 22 },
      "id": 14,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showPercentChange": false, "textMode": "auto", "wideLayout": true },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "browserpane-prometheus" }, "editorMode": "code", "expr": "browserpane:workflow_event_delivery_failures:increase15m", "instant": true, "legendFormat": "Delivery failures", "range": false, "refId": "A" }],
