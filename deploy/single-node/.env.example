# Non-secret single-node deployment inputs. Copy to an operator-owned env file.
BPANE_DEPLOYMENT_NAME=browserpane

# Every image must be an immutable repository digest or sha256 image ID.
BPANE_WEB_IMAGE=registry.example/browserpane/web@sha256:REPLACE_WITH_64_HEX_CHARACTERS
BPANE_GATEWAY_IMAGE=registry.example/browserpane/gateway@sha256:REPLACE_WITH_64_HEX_CHARACTERS
BPANE_RUNTIME_BROKER_IMAGE=registry.example/browserpane/runtime-broker@sha256:REPLACE_WITH_64_HEX_CHARACTERS
BPANE_DOCKER_PROXY_IMAGE=ghcr.io/tecnativa/docker-socket-proxy@sha256:REPLACE_WITH_64_HEX_CHARACTERS
BPANE_BROWSER_IMAGE=registry.example/browserpane/browser@sha256:REPLACE_WITH_64_HEX_CHARACTERS
BPANE_WORKFLOW_WORKER_IMAGE=registry.example/browserpane/workflow-worker@sha256:REPLACE_WITH_64_HEX_CHARACTERS
BPANE_RECORDING_WORKER_IMAGE=registry.example/browserpane/recording-worker@sha256:REPLACE_WITH_64_HEX_CHARACTERS
BPANE_STORAGE_HELPER_IMAGE=registry.example/browserpane/browser@sha256:REPLACE_WITH_64_HEX_CHARACTERS

# Browser-facing URLs use organization-owned DNS and trusted TLS.
BPANE_WEB_BIND_ADDRESS=127.0.0.1
BPANE_WEB_PORT=8080
BPANE_WEBTRANSPORT_PORT=4433
BPANE_PUBLIC_GATEWAY_URL=https://browser.example:4433
BPANE_BROWSER_START_URL=https://example.org/

# Public issuer is embedded in browser auth config. JWKS/token URLs are service-facing.
BPANE_OIDC_PROVIDER_HINT=oidc
BPANE_OIDC_PUBLIC_ISSUER=https://identity.example/realms/browserpane
BPANE_OIDC_INTERNAL_JWKS_URL=https://identity.example/realms/browserpane/protocol/openid-connect/certs
BPANE_OIDC_TOKEN_URL=https://identity.example/realms/browserpane/protocol/openid-connect/token
BPANE_OIDC_GATEWAY_AUDIENCE=bpane-gateway
BPANE_OIDC_BROWSER_CLIENT_ID=bpane-web
BPANE_OIDC_BROWSER_SCOPE=openid
BPANE_OIDC_BROKER_AUDIENCE=bpane-runtime-broker
BPANE_OIDC_BROKER_GATEWAY_CLIENT_ID=bpane-runtime-broker-gateway
BPANE_OIDC_WORKER_CLIENT_ID=bpane-worker
BPANE_OIDC_WORKER_SCOPES=

# External dependency endpoints contain no embedded credentials.
BPANE_VAULT_ADDR=https://vault.example
BPANE_VAULT_MOUNT_PATH=secret
BPANE_VAULT_PREFIX=browserpane/credential-bindings

# Paths point to owner-only files outside the repository.
BPANE_DATABASE_URL_FILE=/etc/browserpane/secrets/database-url
BPANE_VAULT_TOKEN_FILE=/etc/browserpane/secrets/vault-token
BPANE_BROKER_GATEWAY_CLIENT_SECRET_FILE=/etc/browserpane/secrets/broker-gateway-client-secret
BPANE_WORKER_OIDC_CLIENT_SECRET_FILE=/etc/browserpane/secrets/worker-oidc-client-secret
BPANE_TLS_CERT_FILE=/etc/browserpane/tls/fullchain.pem
BPANE_TLS_KEY_FILE=/etc/browserpane/tls/privkey.pem

# Bounded admission and worker behavior.
BPANE_MAX_ACTIVE_RUNTIMES=4
BPANE_MAX_STARTING_RUNTIMES=1
BPANE_MAX_VIEWERS=10
BPANE_BROKER_MAX_CONCURRENT=16
BPANE_WORKFLOW_MAX_ACTIVE=4
BPANE_BROWSER_FPS=30
