# BrowserPane Host Agent - Ubuntu 24.04 LTS
ARG BPANE_RUST_BUILDER_IMAGE=ubuntu:24.04@sha256:561618e2c15bf2397621dd04f96926663a3b5616c189cf7e38db7e82f5c538ea
FROM ${BPANE_RUST_BUILDER_IMAGE} AS builder

ENV CARGO_HOME=/opt/cargo \
    RUSTUP_HOME=/opt/rustup \
    PATH=/opt/cargo/bin:${PATH} \
    CARGO_INCREMENTAL=0

COPY deploy/install-rust-toolchain.sh rust-toolchain.toml /tmp/
RUN if ! command -v cargo >/dev/null 2>&1; then \
      apt-get update \
      && apt-get install -y --no-install-recommends \
        build-essential ca-certificates curl pkg-config \
        libavcodec-dev libavutil-dev libdrm-dev libevdev-dev libopus-dev \
        libpipewire-0.3-dev libva-dev libx11-dev libxcb1-dev libxdamage-dev \
        libxfixes-dev libxrandr-dev \
      && rm -rf /var/lib/apt/lists/* \
      && rust_toolchain="$(awk -F '"' '/^[[:space:]]*channel[[:space:]]*=/{print $2}' /tmp/rust-toolchain.toml)" \
      && /tmp/install-rust-toolchain.sh "${rust_toolchain}"; \
    fi \
    && rm /tmp/install-rust-toolchain.sh /tmp/rust-toolchain.toml

WORKDIR /build
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY code/shared/bpane-protocol code/shared/bpane-protocol
COPY code/shared/bpane-runtime-contract code/shared/bpane-runtime-contract
RUN mkdir -p code/shared/bpane-runtime-client/src
COPY code/shared/bpane-runtime-client/Cargo.toml code/shared/bpane-runtime-client/Cargo.toml
RUN printf '%s\n' 'pub fn dependency_seed() {}' > code/shared/bpane-runtime-client/src/lib.rs
COPY code/apps/bpane-host code/apps/bpane-host
RUN mkdir -p code/apps/bpane-gateway/src
COPY code/apps/bpane-gateway/Cargo.toml code/apps/bpane-gateway/Cargo.toml
RUN echo 'fn main() {}' > code/apps/bpane-gateway/src/main.rs
RUN mkdir -p code/apps/bpane-runtime-broker/src
COPY code/apps/bpane-runtime-broker/Cargo.toml code/apps/bpane-runtime-broker/Cargo.toml
RUN printf '%s\n' 'pub fn dependency_seed() {}' > code/apps/bpane-runtime-broker/src/lib.rs \
    && printf '%s\n' 'fn main() {}' > code/apps/bpane-runtime-broker/src/main.rs

RUN cargo build --release --locked -p bpane-host

# Runtime image
FROM ubuntu:24.04

RUN apt-get update && apt-get install -y \
    # Xorg with dummy video driver — supports runtime xrandr mode switching
    xserver-xorg-core \
    xserver-xorg-video-dummy \
    x11-xserver-utils \
    x11-apps \
    # FFmpeg for X11 capture + H.264 encode
    ffmpeg \
    # PipeWire + PulseAudio compat for desktop audio capture
    pipewire \
    pipewire-pulse \
    wireplumber \
    libspa-0.2-libcamera \
    # D-Bus session bus (required by PipeWire/WirePlumber)
    dbus-x11 \
    # PulseAudio CLI tools (pactl for audio detection)
    pulseaudio-utils \
    # xclip for clipboard sync
    xclip \
    # socat for proxying CDP from loopback to all interfaces
    socat \
    # Shared libraries
    libdrm2 \
    libevdev2 \
    libx11-6 \
    libxcb1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libavcodec60 \
    libavutil58 \
    libva2 \
    libpipewire-0.3-0 \
    libopus0 \
    # Chromium GPU probe requires libpci
    libpci3 \
    # certutil installs per-session interception CAs into Chromium's NSS trust DB
    libnss3-tools \
    # Window manager
    openbox \
    # Fonts
    fonts-liberation \
    fonts-dejavu-core \
    # Chromium from xtradeb PPA (real .deb package, no snap runtime)
    software-properties-common \
    && add-apt-repository -y ppa:xtradeb/apps \
    && apt-get update && apt-get install -y chromium \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -f input && \
    useradd -m -s /bin/bash bpane && \
    usermod -aG input,video,audio bpane

RUN mkdir -p /run/bpane/session \
      /run/bpane/storage-helper/session \
      /run/bpane/storage-helper/session/chromium \
      /run/bpane/storage-helper/session/downloads \
      /run/bpane/storage-helper/session/egress \
      /run/bpane/storage-helper/session/mounts \
      /run/bpane/storage-helper/session/uploads \
      /run/bpane/storage-helper/input \
      /run/bpane/storage-helper/source \
      /run/bpane/storage-helper/target \
      /home/bpane/bpane-downloads /home/bpane/bpane-uploads && \
    chown -R bpane:bpane /run/bpane /home/bpane

COPY --from=builder /build/target/release/bpane-host /usr/local/bin/bpane-host
COPY deploy/xorg-dummy.conf /etc/X11/xorg-dummy.conf
COPY deploy/chromium-policies/managed /etc/chromium/policies/managed
COPY deploy/start-host.sh /usr/local/bin/start-host.sh
COPY deploy/bpane-ext /home/bpane/bpane-ext
COPY deploy/bpane-test-extension /home/bpane/bpane-test-extension
RUN chmod +x /usr/local/bin/start-host.sh

USER bpane
WORKDIR /home/bpane

CMD ["/usr/local/bin/start-host.sh"]
