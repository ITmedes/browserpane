# BrowserPane Gateway Server
ARG BPANE_RUST_BUILDER_IMAGE=ubuntu:24.04@sha256:561618e2c15bf2397621dd04f96926663a3b5616c189cf7e38db7e82f5c538ea
FROM ${BPANE_RUST_BUILDER_IMAGE} AS builder

ENV CARGO_HOME=/opt/cargo \
    RUSTUP_HOME=/opt/rustup \
    PATH=/opt/cargo/bin:${PATH} \
    CARGO_INCREMENTAL=0

COPY deploy/install-rust-toolchain.sh rust-toolchain.toml /tmp/
RUN if ! command -v cargo >/dev/null 2>&1; then \
      apt-get update \
      && apt-get install -y --no-install-recommends \
        build-essential ca-certificates cmake curl pkg-config \
      && rm -rf /var/lib/apt/lists/* \
      && rust_toolchain="$(awk -F '"' '/^[[:space:]]*channel[[:space:]]*=/{print $2}' /tmp/rust-toolchain.toml)" \
      && /tmp/install-rust-toolchain.sh "${rust_toolchain}"; \
    fi \
    && rm /tmp/install-rust-toolchain.sh /tmp/rust-toolchain.toml

WORKDIR /build
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY code/shared/bpane-protocol code/shared/bpane-protocol
COPY code/shared/bpane-runtime-contract code/shared/bpane-runtime-contract
COPY code/shared/bpane-runtime-client code/shared/bpane-runtime-client
COPY code/apps/bpane-gateway code/apps/bpane-gateway
# Stub other crate
RUN mkdir -p code/apps/bpane-host/src
COPY code/apps/bpane-host/Cargo.toml code/apps/bpane-host/Cargo.toml
RUN echo 'fn main() {}' > code/apps/bpane-host/src/main.rs
RUN mkdir -p code/apps/bpane-runtime-broker/src
COPY code/apps/bpane-runtime-broker/Cargo.toml code/apps/bpane-runtime-broker/Cargo.toml
RUN printf '%s\n' 'pub fn dependency_seed() {}' > code/apps/bpane-runtime-broker/src/lib.rs \
    && printf '%s\n' 'fn main() {}' > code/apps/bpane-runtime-broker/src/main.rs

RUN cargo build --release --locked -p bpane-gateway

# Runtime image
FROM ubuntu:24.04

RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    git \
    docker.io \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/target/release/bpane-gateway /usr/local/bin/bpane-gateway

EXPOSE 4433/udp

CMD ["/usr/local/bin/bpane-gateway"]
