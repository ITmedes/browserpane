# BrowserPane Web Frontend
# Stage 1: Build the bpane-client SDK
FROM node:22-alpine AS build
WORKDIR /app
COPY code/web/bpane-client/package.json code/web/bpane-client/package-lock.json* ./
RUN npm ci
COPY code/web/bpane-client/ ./
RUN npm run build

# Stage 2: Build the bpane-admin console
FROM node:22-alpine AS build-admin
WORKDIR /bpane-admin-auth
COPY code/web/bpane-admin-auth/package.json ./
COPY code/web/bpane-admin-auth/src ./src
WORKDIR /admin
ENV BPANE_ADMIN_BASE_PATH=/admin
COPY code/web/bpane-admin/package.json code/web/bpane-admin/package-lock.json* code/web/bpane-admin/.npmrc ./
RUN npm ci
COPY code/web/bpane-admin/ ./
RUN npm run build

# Stage 3: Build the new route-backed bpane-admin console
FROM node:22-alpine AS build-admin-unified
WORKDIR /bpane-admin-auth
COPY code/web/bpane-admin-auth/package.json ./
COPY code/web/bpane-admin-auth/src ./src
WORKDIR /admin-unified
ENV BPANE_ADMIN_BASE_PATH=/admin-new
COPY code/web/bpane-admin-unified/package.json code/web/bpane-admin-unified/package-lock.json* code/web/bpane-admin-unified/.npmrc ./
RUN npm ci
COPY code/web/bpane-admin-unified/ ./
RUN npm run build

# Stage 4: Serve via nginx
FROM nginx:alpine
RUN rm /etc/nginx/conf.d/default.conf
RUN apk add --no-cache gettext openssl
COPY deploy/nginx.conf /etc/nginx/conf.d/bpane.conf
COPY deploy/nginx-admin-security-headers.conf /etc/nginx/snippets/admin-security-headers.conf
COPY deploy/web-cert-metadata.sh /docker-entrypoint.d/20-web-cert-metadata.sh
COPY deploy/web-auth-config.sh /docker-entrypoint.d/30-web-auth-config.sh
RUN chmod +x /docker-entrypoint.d/20-web-cert-metadata.sh
RUN chmod +x /docker-entrypoint.d/30-web-auth-config.sh
COPY dev/web-fixtures/index.html /usr/share/nginx/html/index.html
COPY dev/web-fixtures/test-embed.html /usr/share/nginx/html/test-embed.html
COPY dev/web-fixtures/recording-worker.html /usr/share/nginx/html/recording-worker.html
COPY dev/web-fixtures/benchmark-scroll.html /usr/share/nginx/html/benchmark-scroll.html
COPY dev/web-fixtures/benchmark-article.html /usr/share/nginx/html/benchmark-article.html
COPY dev/web-fixtures/workflow-credential-fixture.html /usr/share/nginx/html/workflow-credential-fixture.html
COPY dev/web-fixtures/workflow-extension-fixture.html /usr/share/nginx/html/workflow-extension-fixture.html
COPY dev/web-fixtures/auth-config.template.json /usr/share/nginx/html/auth-config.template.json
COPY openapi/bpane-control-v1.yaml /usr/share/nginx/html/openapi/bpane-control-v1.yaml
COPY openapi/bpane-control-v1.operations.json /usr/share/nginx/html/openapi/bpane-control-v1.operations.json
COPY openapi/bpane-control-v1.classifications.json /usr/share/nginx/html/openapi/bpane-control-v1.classifications.json
COPY openapi/bpane-control-v1.examples.json /usr/share/nginx/html/openapi/bpane-control-v1.examples.json
COPY openapi/bpane-control-v1.compatibility.json /usr/share/nginx/html/openapi/bpane-control-v1.compatibility.json
COPY --from=build /app/dist/ /usr/share/nginx/html/dist/
COPY --from=build-admin /admin/build/ /usr/share/nginx/html/admin/
COPY --from=build-admin-unified /admin-unified/build/ /usr/share/nginx/html/admin-new/

EXPOSE 8080
