# syntax=docker/dockerfile:1.7

FROM ubuntu:24.04@sha256:561618e2c15bf2397621dd04f96926663a3b5616c189cf7e38db7e82f5c538ea

ARG BPANE_BUILDER_REVISION=unknown
ARG BPANE_BUILDER_VERSION=local
ARG RUST_TOOLCHAIN=1.93.1
ARG RUSTUP_VERSION=1.28.2
ARG RUSTUP_INIT_SHA256=20a06e644b0d9bd2fbdbfd52d42540bdde820ea7df86e92e533c073da0cdd43c

LABEL org.opencontainers.image.title="BrowserPane CI Rust builder" \
      org.opencontainers.image.description="Pinned Rust and native dependency builder for BrowserPane CI" \
      org.opencontainers.image.source="https://github.com/ITmedes/browserpane" \
      org.opencontainers.image.revision="${BPANE_BUILDER_REVISION}" \
      org.opencontainers.image.version="${BPANE_BUILDER_VERSION}" \
      org.opencontainers.image.licenses="MIT"

ENV CARGO_HOME=/opt/cargo \
    RUSTUP_HOME=/opt/rustup \
    PATH=/opt/cargo/bin:${PATH} \
    CARGO_INCREMENTAL=0

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    curl \
    git \
    libavcodec-dev \
    libavutil-dev \
    libdrm-dev \
    libevdev-dev \
    libopus-dev \
    libpipewire-0.3-dev \
    libva-dev \
    libx11-dev \
    libxcb1-dev \
    libxdamage-dev \
    libxfixes-dev \
    libxrandr-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 --fail --silent --show-error --location \
      "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/x86_64-unknown-linux-gnu/rustup-init" \
      --output /tmp/rustup-init \
    && echo "${RUSTUP_INIT_SHA256}  /tmp/rustup-init" | sha256sum --check --strict \
    && chmod +x /tmp/rustup-init \
    && /tmp/rustup-init -y --profile minimal --default-toolchain none \
    && rm /tmp/rustup-init \
    && rustup toolchain install "${RUST_TOOLCHAIN}" --profile minimal \
      --component clippy --component llvm-tools-preview --component rustfmt \
    && rustup default "${RUST_TOOLCHAIN}" \
    && cargo --version \
    && rustc --version

WORKDIR /build

# Only dependency-contract inputs enter this image. BrowserPane implementation
# source is replaced by stubs so later source changes reuse third-party output.
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY code/shared/bpane-protocol/Cargo.toml code/shared/bpane-protocol/Cargo.toml
COPY code/apps/bpane-host/Cargo.toml code/apps/bpane-host/Cargo.toml
COPY code/apps/bpane-gateway/Cargo.toml code/apps/bpane-gateway/Cargo.toml

RUN mkdir -p \
      code/shared/bpane-protocol/src \
      code/apps/bpane-host/src \
      code/apps/bpane-gateway/src \
    && printf '%s\n' 'pub fn dependency_seed() {}' \
      > code/shared/bpane-protocol/src/lib.rs \
    && printf '%s\n' 'fn main() {}' > code/apps/bpane-host/src/main.rs \
    && printf '%s\n' 'fn main() {}' > code/apps/bpane-gateway/src/main.rs \
    && cargo build --workspace --release --locked \
    && rm -rf Cargo.toml Cargo.lock rust-toolchain.toml code \
    && rm -f target/release/bpane-gateway target/release/bpane-host

CMD ["cargo", "test", "--workspace", "--locked"]
