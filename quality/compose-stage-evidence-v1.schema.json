{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://browserpane.dev/schemas/compose-stage-evidence-v1.schema.json",
  "title": "BrowserPane Compose stage evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "run",
    "identity",
    "lane",
    "outcome",
    "primary_failure",
    "cleanup",
    "stages",
    "artifacts",
    "evidence_errors"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "generated_at": { "type": "string", "format": "date-time", "maxLength": 40 },
    "run": { "$ref": "#/$defs/run" },
    "identity": { "$ref": "#/$defs/identity" },
    "lane": { "type": "string", "pattern": "^[a-z0-9-]{1,48}$" },
    "outcome": { "enum": ["success", "failure", "cancelled"] },
    "primary_failure": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/failure" }
      ]
    },
    "cleanup": { "$ref": "#/$defs/cleanup" },
    "stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/stage" }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 12,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "evidence_errors": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "maxLength": 160 }
    }
  },
  "$defs": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "attempt", "event", "first_pass"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9]{1,24}$" },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 100 },
        "event": { "type": "string", "pattern": "^[a-z_]{1,32}$" },
        "first_pass": { "type": "boolean" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tested_commit",
        "tested_tree",
        "workflow_sha256",
        "test_plan_sha256",
        "image_digests"
      ],
      "properties": {
        "tested_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tested_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "workflow_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "test_plan_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "image_digests": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_id", "class", "outcome", "exit_code", "signal"],
      "properties": {
        "stage_id": { "type": "string", "pattern": "^[a-z0-9-]{1,48}$" },
        "class": { "enum": ["product", "harness", "infrastructure", "unknown"] },
        "outcome": { "enum": ["failure", "cancelled"] },
        "exit_code": { "type": ["integer", "null"], "minimum": 0, "maximum": 255 },
        "signal": { "type": ["string", "null"], "pattern": "^SIG[A-Z0-9]+$" }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "duration_ms", "exit_code", "signal"],
      "properties": {
        "outcome": { "enum": ["success", "failure", "cancelled", "unknown"] },
        "duration_ms": { "type": ["integer", "null"], "minimum": 0, "maximum": 21600000 },
        "exit_code": { "type": ["integer", "null"], "minimum": 0, "maximum": 255 },
        "signal": { "type": ["string", "null"], "pattern": "^SIG[A-Z0-9]+$" }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sequence",
        "role",
        "required_when",
        "outcome",
        "failure_class",
        "started_at",
        "duration_ms",
        "exit_code",
        "signal",
        "reproduction_command"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]{1,48}$" },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 32 },
        "role": { "enum": ["primary", "diagnostics", "cleanup"] },
        "required_when": { "enum": ["success", "failure", "always"] },
        "isolation": { "enum": ["none", "resources"] },
        "outcome": { "enum": ["success", "failure", "cancelled", "skipped", "unknown"] },
        "failure_class": {
          "type": ["string", "null"],
          "enum": ["product", "harness", "infrastructure", "unknown", null]
        },
        "started_at": { "type": ["string", "null"], "maxLength": 40 },
        "duration_ms": { "type": ["integer", "null"], "minimum": 0, "maximum": 21600000 },
        "exit_code": { "type": ["integer", "null"], "minimum": 0, "maximum": 255 },
        "signal": { "type": ["string", "null"], "pattern": "^SIG[A-Z0-9]+$" },
        "reproduction_command": { "type": "string", "minLength": 1, "maxLength": 240 },
        "harness": { "$ref": "#/$defs/harness" }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "namespaces", "readiness", "cleanup"],
      "properties": {
        "namespace": { "type": "string", "pattern": "^[a-z0-9-]{1,63}$" },
        "namespaces": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9-]{1,63}$" }
        },
        "readiness": { "$ref": "#/$defs/harnessReadiness" },
        "cleanup": { "$ref": "#/$defs/harnessCleanup" }
      }
    },
    "harnessReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundaries", "observations", "attempts", "failures", "elapsed_ms", "last_state"],
      "properties": {
        "boundaries": {
          "type": "array",
          "maxItems": 7,
          "uniqueItems": true,
          "items": { "enum": ["oidc", "control", "runtime", "transport", "workflow_worker", "recording_worker", "artifact"] }
        },
        "observations": { "type": "integer", "minimum": 0, "maximum": 256 },
        "attempts": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "failures": { "type": "integer", "minimum": 0, "maximum": 256 },
        "elapsed_ms": { "type": "integer", "minimum": 0, "maximum": 21600000 },
        "last_state": { "type": ["string", "null"], "maxLength": 80 }
      }
    },
    "harnessCleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "checks", "failures", "attempts", "elapsed_ms", "last_state"],
      "properties": {
        "outcome": { "enum": ["success", "failure"] },
        "checks": { "type": "integer", "minimum": 0, "maximum": 256 },
        "failures": { "type": "integer", "minimum": 0, "maximum": 256 },
        "attempts": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "elapsed_ms": { "type": "integer", "minimum": 0, "maximum": 21600000 },
        "last_state": { "type": ["string", "null"], "maxLength": 80 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "bytes", "sha256"],
      "properties": {
        "kind": { "enum": ["diagnostics", "trace", "screenshot"] },
        "path": { "type": "string", "pattern": "^(?:attachments/[a-z0-9][a-z0-9._-]{0,80}\\.(?:png|webp|zip)|test-results/ci-diagnostics/compose\\.log)$" },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 5242880 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
